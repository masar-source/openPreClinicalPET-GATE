#####################################################################################
# Quad35 RF coil (35 mm inner diameter), full model. There is no mu-map of this coil, so I
# reconstructed it from the published image of its attenuation map (Kuntner et al. 2025, Fig. 6A),
# with the length scale and the materials taken from the Quad86 mu-map. It is an ESTIMATE from an
# image, not a measured map. GATE primitives (cylinders, cones), z = 0 at the PET FOV centre.
#   quad35_coil_bore.mac : parts reaching into |z| <= 82.5 mm (6 parts) -> acquisitions
#   quad35_coil_all.mac  : every part (21 parts)                          -> visualisation
# The cut run models in the test folders use different walls: three G10 walls whose thicknesses
# were adjusted to the measured Quad35 sensitivity and count rates (see full_coil_models/README.md).
# To use this model in another macro, copy quad35_coil/ next to the macro and, where the coil is
# defined, add
#     /control/execute quad35_coil/quad35_coil_bore.mac
#####################################################################################

/gate/geometry/setMaterialDatabase quad35_coil/Quad35Coil.db

# --- parts reaching into the bore ---
/gate/world/daughters/name q35_inner_lower
/gate/world/daughters/insert cylinder
/gate/q35_inner_lower/setMaterial AC_G10
/gate/q35_inner_lower/geometry/setRmin 17.500 mm
/gate/q35_inner_lower/geometry/setRmax 18.300 mm
/gate/q35_inner_lower/geometry/setHeight 183.500 mm
/gate/q35_inner_lower/placement/setTranslation 0 0 -16.750 mm
/gate/q35_inner_lower/vis/setColor red
/gate/q35_inner_lower/attachPhantomSD

/gate/world/daughters/name q35_collar
/gate/world/daughters/insert cylinder
/gate/q35_collar/setMaterial AC_G10
/gate/q35_collar/geometry/setRmin 17.500 mm
/gate/q35_collar/geometry/setRmax 20.050 mm
/gate/q35_collar/geometry/setHeight 8.000 mm
/gate/q35_collar/placement/setTranslation 0 0 79.000 mm
/gate/q35_collar/vis/setColor red
/gate/q35_collar/attachPhantomSD

/gate/world/daughters/name q35_middle_wall
/gate/world/daughters/insert cylinder
/gate/q35_middle_wall/setMaterial AC_G10
/gate/q35_middle_wall/geometry/setRmin 29.150 mm
/gate/q35_middle_wall/geometry/setRmax 30.850 mm
/gate/q35_middle_wall/geometry/setHeight 435.500 mm
/gate/q35_middle_wall/placement/setTranslation 0 0 109.250 mm
/gate/q35_middle_wall/vis/setColor red
/gate/q35_middle_wall/attachPhantomSD

/gate/world/daughters/name q35_outer_shell
/gate/world/daughters/insert cylinder
/gate/q35_outer_shell/setMaterial AC_G10
/gate/q35_outer_shell/geometry/setRmin 55.030 mm
/gate/q35_outer_shell/geometry/setRmax 56.370 mm
/gate/q35_outer_shell/geometry/setHeight 591.000 mm
/gate/q35_outer_shell/placement/setTranslation 0 0 104.000 mm
/gate/q35_outer_shell/vis/setColor red
/gate/q35_outer_shell/attachPhantomSD

/gate/world/daughters/name q35_disc_z51
/gate/world/daughters/insert cylinder
/gate/q35_disc_z51/setMaterial AC_G10
/gate/q35_disc_z51/geometry/setRmin 18.300 mm
/gate/q35_disc_z51/geometry/setRmax 29.150 mm
/gate/q35_disc_z51/geometry/setHeight 1.000 mm
/gate/q35_disc_z51/placement/setTranslation 0 0 51.000 mm
/gate/q35_disc_z51/vis/setColor red
/gate/q35_disc_z51/attachPhantomSD

/gate/world/daughters/name q35_disc_z69
/gate/world/daughters/insert cylinder
/gate/q35_disc_z69/setMaterial AC_G10
/gate/q35_disc_z69/geometry/setRmin 18.300 mm
/gate/q35_disc_z69/geometry/setRmax 29.150 mm
/gate/q35_disc_z69/geometry/setHeight 1.000 mm
/gate/q35_disc_z69/placement/setTranslation 0 0 69.350 mm
/gate/q35_disc_z69/vis/setColor red
/gate/q35_disc_z69/attachPhantomSD
