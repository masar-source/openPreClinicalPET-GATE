# Overlap check of the Quad35 coil (bore parts) with the mouse cradle and the NECR mouse phantom.
# Needs mouse_bed/ (from mouse_bed_gate82/) next to quad35_coil/. From the GATE project folder:
#     Gate quad35_coil/check_with_mouse_bed.mac > check_q35_mouse.log 2>&1
/gate/geometry/setMaterialDatabase Material/GateMaterials.db

/gate/world/geometry/setXLength 100 cm
/gate/world/geometry/setYLength 100 cm
/gate/world/geometry/setZLength 100 cm
/gate/world/setMaterial Air
/gate/world/vis/setVisible 0

# PET system volume of the test macros (PETscanner: air, r 56.9-99 mm, 155 mm long), for orientation and the check
/gate/world/daughters/name   PETboreOutline
/gate/world/daughters/insert cylinder
/gate/PETboreOutline/setMaterial         Air
/gate/PETboreOutline/geometry/setRmin    56.9 mm
/gate/PETboreOutline/geometry/setRmax    99 mm
/gate/PETboreOutline/geometry/setHeight  155 mm
/gate/PETboreOutline/vis/setColor        green
/gate/PETboreOutline/vis/forceWireframe

/control/execute quad35_coil/quad35_coil_bore.mac
/control/execute mouse_bed/mouse_bed_bore.mac

# NECR mouse phantom at its Quad35 position (polyethylene, r 12.5 mm, 70 mm long, centre 4.5 mm above the axis)
/gate/world/daughters/name   mousePhantomCheck
/gate/world/daughters/insert cylinder
/gate/mousePhantomCheck/setMaterial Polyethylene
/gate/mousePhantomCheck/geometry/setRmin 0 mm
/gate/mousePhantomCheck/geometry/setRmax 12.5 mm
/gate/mousePhantomCheck/geometry/setHeight 70 mm
/gate/mousePhantomCheck/placement/setTranslation 0 4.5 0 mm

/gate/physics/addPhysicsList empenelope
/gate/run/initialize

/geometry/test/resolution 2000
/geometry/test/tolerance 0. mm
/geometry/test/run
