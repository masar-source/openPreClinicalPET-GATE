# Visualisation of the Quad35 coil only (no source, no acquisition). Do not run this file directly:
# run vis_bore.mac or vis_all.mac from a GATE project folder that holds Material/GateMaterials.db
# and quad35_coil/.
/gate/geometry/setMaterialDatabase Material/GateMaterials.db

/gate/world/geometry/setXLength 100 cm
/gate/world/geometry/setYLength 100 cm
/gate/world/geometry/setZLength 100 cm
/gate/world/setMaterial Air
/gate/world/vis/setVisible 0

# PET system volume of the test macros (PETscanner: air, r 56.9-99 mm, 155 mm long), as a wireframe for orientation
/gate/world/daughters/name   PETboreOutline
/gate/world/daughters/insert cylinder
/gate/PETboreOutline/setMaterial         Air
/gate/PETboreOutline/geometry/setRmin    56.9 mm
/gate/PETboreOutline/geometry/setRmax    99 mm
/gate/PETboreOutline/geometry/setHeight  155 mm
/gate/PETboreOutline/vis/setColor        green
/gate/PETboreOutline/vis/forceWireframe

/control/execute quad35_coil/quad35_coil_{coilParts}.mac

/gate/physics/addPhysicsList empenelope
/gate/run/initialize

/vis/open {visDriver}
/vis/viewer/set/autoRefresh false
/vis/drawVolume
/vis/viewer/set/style surface
/vis/viewer/set/hiddenMarker true
/vis/viewer/set/viewpointThetaPhi 60 60
/vis/viewer/zoom 1.5
/vis/viewer/set/autoRefresh true
/vis/viewer/flush
